<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MeowGodotLauncher</RootNamespace>
    <AssemblyName>MeowGodotLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- Release builds are published with Native AOT (see .github/workflows/ci.yml): a native executable with no JIT,
       next to the native libraries Avalonia uses (Skia, HarfBuzz and, depending on the platform, ANGLE or Avalonia.Native). -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Released packages update themselves from the launcher's releases (-p:SelfUpdate=true in .github/workflows/ci.yml).
       Other builds don't, so a build made from source is never replaced by a release. -->
  <PropertyGroup Condition="'$(SelfUpdate)' == 'true'">
    <DefineConstants>$(DefineConstants);SELF_UPDATE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeowGodotLauncher.Core\MeowGodotLauncher.Core.csproj" />
  </ItemGroup>
</Project>
